{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://eskufest.styxiner.dev",
          "http://localhost:4200"
        ],
        "methods": [
          "GET",
          "HEAD",
          "PUT"
        ],
        "headers": [
          "content-type",
          "if-none-match"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
